#!/bin/bash
# pre-commit hook: force release notes on every commit
# Avvia release-notes in modalità Web UI e attende che l'utente compili il form

REPO_ROOT=$(git rev-parse --show-toplevel)
COMMIT_MSG_FILE="${GIT_INDEX_FILE%.lock}/commit-editmsg"

# Fallback per trovare il file del messaggio
if [ ! -f "$COMMIT_MSG_FILE" ]; then
  if [ -f "$REPO_ROOT/.git/COMMIT_EDITMSG" ]; then
    COMMIT_MSG_FILE="$REPO_ROOT/.git/COMMIT_EDITMSG"
  elif [ -n "$1" ]; then
    COMMIT_MSG_FILE="$1"
  else
    # Se non troviamo niente, crea un file temporaneo vuoto (Git fallback)
    COMMIT_MSG_FILE=$(mktemp)
    echo "Commit automatico" > "$COMMIT_MSG_FILE"
  fi
fi

RELEASE_NOTES_JSON="$REPO_ROOT/release_notes.json"
RELEASE_TOOL="release-notes"

# Verifica che il tool sia disponibile
if ! command -v "$RELEASE_TOOL" &> /dev/null; then
  echo "ERRORE: release-notes non trovato nel PATH"
  echo "Installa il tool oppure aggiungi la directory al PATH"
  exit 1
fi

# Crea il file JSON se non esiste
if [ ! -f "$RELEASE_NOTES_JSON" ]; then
  mkdir -p "$REPO_ROOT"
  echo '{"releases":[]}' > "$RELEASE_NOTES_JSON"
fi

# Usa una porta dinamica per evitare conflitti
PORT=9999
# Verifica se la porta è già usata, altrimenti usa un'altra
for p in 9999 9998 9997 9996 9995; do
  if ! nc -z 127.0.0.1 $p 2>/dev/null; then
    PORT=$p
    break
  fi
done

# Lancia il tool in modalità Web UI
# Nota: il tool si blocca qui finché l'utente non salva il form dal browser
"$RELEASE_TOOL" --serve ":$PORT" --commit-msg "$COMMIT_MSG_FILE" --json-out "$RELEASE_NOTES_JSON"
TOOL_EXIT=$?

# Se il tool è uscito con errore, il commit viene abortito
if [ $TOOL_EXIT -ne 0 ]; then
  echo "ERRORE: Release notes non salvate. Commit abortito."
  exit 1
fi

# Verifica che il file JSON sia stato effettivamente creato/aggiornato
if [ ! -f "$RELEASE_NOTES_JSON" ]; then
  echo "ERRORE: file release_notes.json non creato. Commit abortito."
  exit 1
fi

# Aggiungi il file delle release notes al commit
git add "$RELEASE_NOTES_JSON"

# Successo!
exit 0
