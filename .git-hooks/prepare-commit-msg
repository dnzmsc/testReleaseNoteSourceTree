
#!/bin/bash

# Parametri passati da Git al prepare-commit-msg
COMMIT_MSG_FILE="$1"   # Questo è il path al file che vuoi passare alla tua app
COMMIT_SOURCE="$2"
SHA1="$3"

# Path dell'app GUI
RELEASE_NOTES_APP="./release-notes-app"
RELEASE_NOTES_FILE="./release-notes.json"

# Lancia la GUI, passando il file del commit come parametro (come nel tuo main.go)
"$RELEASE_NOTES_APP" "$COMMIT_MSG_FILE"

# Verifica uscita dell'app
if [[ $? -ne 0 ]]; then
  echo "❌ Commit annullato: l'app è stata chiusa o ha dato errore."
  exit 1
fi

# Controlla che release-notes.json sia stato scritto
if [[ ! -f "$RELEASE_NOTES_FILE" ]]; then
  echo "❌ Commit annullato: file release-notes.json non trovato."
  exit 1
fi

# Controlla che sia stato aggiornato recentemente (entro 60 secondi)
NOW=$(date +%s)
MODIFIED=$(stat -c %Y "$RELEASE_NOTES_FILE")
AGE=$((NOW - MODIFIED))

if [[ "$AGE" -gt 60 ]]; then
  echo "❌ Commit annullato: il file release-notes.json non è stato aggiornato di recente."
  exit 1
fi

# Aggiunge il file al commit
git add "$RELEASE_NOTES_FILE"

# Tutto ok
exit 0
