#!/bin/sh

# prepare-commit-msg hook
# Questo script ora non solo prepara il messaggio, ma esegue anche il commit finale
# per garantire che release_notes.json sia incluso nello stesso commit.

# NOTA: Questa configurazione del LOG_FILE assume che lo script si trovi in '.git-hooks/'
LOG_FILE="./.git-hooks/prepare-commit-msg.log"
exec > "$LOG_FILE" 2>&1
echo "--- Inizio Log prepare-commit-msg (SOLUZIONE SPORCA): $(date) ---"

# Abilita la modalità di debug (stampa i comandi eseguiti)
set -x
# Esci immediatamente se un comando fallisce (solo se non gestito esplicitamente)

# --- Configurazione ---
APP="./release-notes-app"
FILE_RELEASE_NOTES="release_notes.json"
COMMIT_MSG_FILE="$1" # Percorso al file del messaggio di commit temporaneo di Git

# --- Inizio Esecuzione Hook ---
echo "----------------------------------------------------"
echo "--- Inizio esecuzione prepare-commit-msg hook (Commit Finalization Mode) ---"
echo "----------------------------------------------------"
echo "DEBUG INFO: Percorso del file messaggio di commit: $COMMIT_MSG_FILE"
echo "DEBUG INFO: Percorso dell'applicazione Fyne: $APP"
echo "DEBUG INFO: Percorso del file Release Notes JSON: $FILE_RELEASE_NOTES"

# 1. Salva il timestamp di modifica del file release_notes.json PRIMA di avviare l'app.
BEFORE_RN_FILE=$(stat -f "%m" "$FILE_RELEASE_NOTES" 2>/dev/null || stat -c "%Y" "$FILE_RELEASE_NOTES" 2>/dev/null || echo "0")
echo "DEBUG INFO: Timestamp iniziale di $FILE_RELEASE_NOTES: '$BEFORE_RN_FILE'"

echo "DEBUG INFO: Stato della working directory e dell'indice (staging area) PRIMA di avviare l'app:"
git status --porcelain
echo "----------------------------------------------------"

# 2. Avvia l'applicazione Fyne.
echo "DEBUG INFO: Avvio applicazione GUI per le Release Notes..."
# Disabilita set -e temporaneamente per controllare l'exit code dell'app manualmente
set +e
"$APP" "$COMMIT_MSG_FILE"
APP_EXIT_CODE=$?
set -e # Riabilita set -e

echo "DEBUG INFO: Applicazione Fyne terminata con Exit Code: $APP_EXIT_CODE"
if [ "$APP_EXIT_CODE" -ne 0 ]; then
    echo "----------------------------------------------------"
    echo "❌ L'applicazione per le Release Notes è stata chiusa con richiesta di annullamento o ha riscontrato un errore."
    echo "Commit annullato."
    exit 1 # Segnala a Git di annullare il commit
fi

# 4. Verifica la presenza del file release_notes.json dopo l'esecuzione dell'app.
if [ ! -f "$FILE_RELEASE_NOTES" ]; then
    echo "----------------------------------------------------"
    echo "❌ ERRORE: File $FILE_RELEASE_NOTES mancante dopo l'esecuzione dell'applicazione."
    echo "Assicurati che l'app abbia i permessi per creare/scrivere il file."
    echo "Commit annullato."
    exit 1
fi

# 5. Verifica se il file release_notes.json è stato effettivamente modificato dall'app.
AFTER_RN_FILE=$(stat -f "%m" "$FILE_RELEASE_NOTES" 2>/dev/null || stat -c "%Y" "$FILE_RELEASE_NOTES")
echo "DEBUG INFO: Timestamp finale di $FILE_RELEASE_NOTES: '$AFTER_RN_FILE'"

if [ "$AFTER_RN_FILE" -le "$BEFORE_RN_FILE" ]; then
    echo "----------------------------------------------------"
    echo "❌ ERRORE: Il file $FILE_RELEASE_NOTES non è stato modificato dall'applicazione."
    echo "Assicurati di aver compilato e salvato almeno una nota di release nella GUI."
    echo "Commit annullato."
    exit 1
fi

# 6. Verifica che l'ultima release nel file JSON abbia la data di oggi.
TODAY=$(date +%Y-%m-%d)
LAST_DATE=$(python3 -c "
import json
import sys
try:
    with open('$FILE_RELEASE_NOTES') as f:
        data = json.load(f)
    if 'releases' in data and len(data['releases']) > 0:
        print(data['releases'][-1]['data'])
    else:
        print('INVALID_DATE')
except (FileNotFoundError, json.JSONDecodeError, IndexError, KeyError) as e:
    print('INVALID_DATE')
    sys.stderr.write(f'DEBUG PYTHON ERROR: {e}\\n')
")

echo "DEBUG INFO: Data dell'ultima release nel file: '$LAST_DATE' (attesa: '$TODAY')"
if [ "$LAST_DATE" != "$TODAY" ]; then
    echo "----------------------------------------------------"
    echo "❌ ERRORE: L'ultima release nel file $FILE_RELEASE_NOTES non è stata aggiornata a oggi ($LAST_DATE)."
    echo "Assicurati di aver salvato una nota per la data corrente."
    echo "Commit annullato."
    exit 1
fi

# --- NUOVA LOGICA DI COMMIT (SOLUZIONE SPORCA) ---
# A questo punto, tutte le validazioni sono passate e l'app Fyne ha modificato release_notes.json.

echo "----------------------------------------------------"
echo "DEBUG INFO: Tentativo di aggiungere $FILE_RELEASE_NOTES all'indice."
echo "DEBUG INFO: Stato dell'indice (staging area) PRIMA di 'git add' (dovrebbe essere MM dopo l'app):"
git status --porcelain

echo "DEBUG INFO: Esecuzione di: git add \"$FILE_RELEASE_NOTES\""
git add "$FILE_RELEASE_NOTES"

# Verifica immediata che il file sia nell'indice.
if ! git ls-files --error-unmatch "$FILE_RELEASE_NOTES" > /dev/null 2>&1; then
    echo "----------------------------------------------------"
    echo "❌ ERRORE CRITICO: Il file $FILE_RELEASE_NOTES NON È STATO AGGIUNTO CORRETTAMENTE all'indice di Git."
    echo "Questo significa che non sarà incluso nel commit. Commit annullato per evitare incoerenze."
    echo "----------------------------------------------------"
    exit 1
fi

echo "DEBUG INFO: Il file $FILE_RELEASE_NOTES è stato VERIFICATO e si trova correttamente nell'indice."
echo "DEBUG INFO: Stato dell'indice (staging area) DOPO 'git add' e verifica (dovrebbe essere A o M senza spazi iniziali):"
git status --porcelain
echo "----------------------------------------------------"

echo "DEBUG INFO: Finalizzazione del commit con il messaggio da '$COMMIT_MSG_FILE'..."

# Esegui il commit effettivo.
# --no-verify: Evita loop infiniti di hook.
# -q: Sopprime l'output normale del commit.
git commit --file "$COMMIT_MSG_FILE" --no-verify -q

# Verifica il successo del commit.
if [ $? -ne 0 ]; then
    echo "----------------------------------------------------"
    echo "❌ Errore durante la finalizzazione del commit da parte dello script."
    echo "Commit annullato."
    exit 1
fi

echo "✅ Commit finalizzato con successo, includendo $FILE_RELEASE_NOTES."
echo "--- prepare-commit-msg hook TERMINATO CON SUCCESSO ---"
echo "Git originale (SourceTree) ora non dovrebbe più committare."
echo "----------------------------------------------------"

exit 255 # Segnala al processo chiamante (SourceTree) che l'operazione è stata completata.
