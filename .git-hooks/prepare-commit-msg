#!/bin/sh

# Definisci il percorso dell'applicazione e del file delle release notes
# Compila la tua app Go con: go build -o release-notes-app
# Poi metti l'eseguibile 'release-notes-app' nella stessa cartella .git/hooks/
APP="./release-notes-app"
FILE_RELEASE_NOTES="release_notes.json" # Rinominato per chiarezza

# Il primo argomento di prepare-commit-msg è il percorso del file temporaneo del messaggio di commit
COMMIT_MSG_FILE="$1"

echo "Running prepare-commit-msg hook..."

# Salva lo stato di modifica del file release_notes.json prima di avviare l'app
BEFORE_RN_FILE=$(stat -f "%m" "$FILE_RELEASE_NOTES" 2>/dev/null || stat -c "%Y" "$FILE_RELEASE_NOTES" 2>/dev/null || echo "0")

echo "✅ Avvio applicazione GUI per le Release Notes..."
# Avvia l'applicazione Fyne, passando il percorso del file del messaggio di commit come argomento.
"$APP" "$COMMIT_MSG_FILE"

# Controlla il codice di uscita dell'applicazione Fyne.
# Se l'applicazione termina con un errore (ad esempio, l'utente ha annullato il salvataggio),
# il commit verrà annullato.
if [ $? -ne 0 ]; then
    echo "❌ L'applicazione per le Release Notes è stata chiusa o ha riscontrato un errore. Commit annullato."
    exit 1
fi

# Verifica presenza file release_notes.json
if [ ! -f "$FILE_RELEASE_NOTES" ]; then
    echo "❌ File $FILE_RELEASE_NOTES mancante dopo l'esecuzione dell'applicazione. Commit annullato."
    exit 1
fi

# Verifica modifica file release_notes.json
AFTER_RN_FILE=$(stat -f "%m" "$FILE_RELEASE_NOTES" 2>/dev/null || stat -c "%Y" "$FILE_RELEASE_NOTES")
if [ "$AFTER_RN_FILE" -le "$BEFORE_RN_FILE" ]; then
    echo "❌ Il file $FILE_RELEASE_NOTES non è stato modificato dall'applicazione. Assicurati di aver salvato almeno una nota."
    echo "Commit annullato."
    exit 1
fi

# Verifica data ultima release nel file release_notes.json
TODAY=$(date +%Y-%m-%d)
LAST_DATE=$(python3 -c "
import json
try:
    with open('$FILE_RELEASE_NOTES') as f:
        data = json.load(f)
    if 'releases' in data and len(data['releases']) > 0:
        print(data['releases'][-1]['data'])
    else:
        print('INVALID_DATE') # Nessuna release o formato non corretto
except (FileNotFoundError, json.JSONDecodeError, IndexError, KeyError):
    print('INVALID_DATE') # Errore nella lettura o parsing
")

if [ "$LAST_DATE" != "$TODAY" ]; then
    echo "❌ L'ultima release nel file $FILE_RELEASE_NOTES non è stata aggiornata a oggi ($LAST_DATE). Commit annullato."
    exit 1
fi

# Aggiungi il file delle release notes all'area di staging
# Questo è l'ultimo passaggio per assicurare che le modifiche al JSON siano incluse nel commit.
git add "$FILE_RELEASE_NOTES"
echo "✅ Release note aggiornata e aggiunta al commit."

exit 0 # Il commit può proseguire
