#!/bin/bash
COMMIT_MSG_FILE="$1"
REPO_ROOT=$(git rev-parse --show-toplevel)
TMP_JSON="$REPO_ROOT/.release_notes_tmp.json"

# Leggo solo la prima riga del messaggio
MESSAGE=$(head -n 1 "$COMMIT_MSG_FILE" | sed 's/"/\\"/g') # scapo eventuali doppi apici

# Data ISO 8601 portabile (su macOS fallback)
if date --iso-8601=seconds >/dev/null 2>&1; then
  DATE=$(date --iso-8601=seconds)
else
  DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
fi

# Scrivo il JSON "a mano"
cat > "$TMP_JSON" << EOF
{
  "message": "$MESSAGE",
  "date": "$DATE"
}
EOF

exit 0

