
#!/bin/bash

# Argomenti: $1 = commit-msg-file, $2 = commit source (es. message), $3 = SHA-1
MSG_FILE="$1"
FILE="release_notes.json"

# Percorso eseguibile dell'app (modifica se necessario)
APP="./release-notes-app"

# Verifica che il file del commit esista
[ -f "$MSG_FILE" ] || exit 1

# Esegui l'app passando il messaggio (o una stringa fittizia se vuoto)
COMMIT_MSG=$(cat "$MSG_FILE")
"$APP" --message "$COMMIT_MSG"

# Funzione per aspettare che il file sia stabile
wait_for_stable_file() {
  local file="$1"
  local prev_hash=""
  local same_count=0
  while true; do
    sleep 0.2
    local hash=$(shasum "$file" 2>/dev/null | awk '{ print $1 }')
    if [ "$hash" = "$prev_hash" ]; then
      ((same_count++))
      if [ "$same_count" -ge 2 ]; then
        break
      fi
    else
      same_count=0
      prev_hash="$hash"
    fi
  done
}

# Attendi che il file venga scritto e sia stabile
if [ -f "$FILE" ]; then
  wait_for_stable_file "$FILE"
  git add "$FILE"
else
  echo "Errore: $FILE non trovato dopo l'esecuzione dell'app." >&2
  exit 1
fi
