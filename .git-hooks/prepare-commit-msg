
#!/bin/bash

# Parametri passati da git
COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"
SHA1="$3"

# Evita di intervenire su merge, squash, rebase, ecc.
if [[ "$COMMIT_SOURCE" == "merge" || "$COMMIT_SOURCE" == "squash" || "$COMMIT_SOURCE" == "commit" ]]; then
  exit 0
fi

# Percorso assoluto dello script Go (modifica se necessario)
RELEASE_NOTES_APP="./release-notes-app"

# Controlla se l'app esiste
if [ ! -x "$RELEASE_NOTES_APP" ]; then
  echo "Errore: $RELEASE_NOTES_APP non trovato o non eseguibile" >&2
  exit 1
fi

# Lancia l'app di raccolta note con il file del messaggio come argomento
"$RELEASE_NOTES_APP" "$COMMIT_MSG_FILE"
STATUS=$?

# Controlla se l'app è terminata con successo
if [ $STATUS -ne 0 ]; then
  echo "Errore: compilazione release notes fallita (codice $STATUS)" >&2
  exit 1
fi

exit 0
