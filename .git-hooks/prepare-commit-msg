#!/bin/bash

# --- Configurazione ---
APP="./release-notes-app"
FILE_RELEASE_NOTES="release_notes.json"
COMMIT_MSG_FILE="$1" # Il primo argomento dell'hook è il percorso del file del messaggio di commit

# --- Log di debug ---
LOG_FILE=".git-hooks/prepare-commit-msg.log"
# Reindirizza stdout e stderr al file di log
exec > >(tee -a "$LOG_FILE") 2>&1
echo "--- Inizio Log prepare-commit-msg (VERIFICA TIMESTAMP): $(date) ---"

# Variabile d'ambiente per indicare che siamo dentro l'hook
export GIT_INSIDE_HOOK_COMMIT=true

echo "----------------------------------------------------"
echo "--- Inizio esecuzione prepare-commit-msg hook (Modalità Timestamp Check) ---"
echo "----------------------------------------------------"
echo "DEBUG INFO: Percorso del file messaggio di commit: $COMMIT_MSG_FILE"
echo "DEBUG INFO: Percorso dell'applicazione Fyne: $APP"
echo "DEBUG INFO: Percorso del file Release Notes JSON: $FILE_RELEASE_NOTES"

# Salva il timestamp di ultima modifica del file release_notes.json PRIMA di avviare l'app
# Nota: La sintassi di `stat` varia tra macOS e Linux/Git Bash
if [[ "$(uname)" == "Darwin" ]]; then # macOS
    BEFORE_RN_FILE=$(stat -f %m "$FILE_RELEASE_NOTES" 2>/dev/null || echo 0)
else # Linux/Windows (con Git Bash)
    BEFORE_RN_FILE=$(stat -c %Y "$FILE_RELEASE_NOTES" 2>/dev/null || echo 0)
fi
echo "DEBUG INFO: Timestamp iniziale di $FILE_RELEASE_NOTES: '$BEFORE_RN_FILE'"

echo "DEBUG INFO: Stato della working directory e dell'indice (staging area) PRIMA di avviare l'app:"
git status --porcelain

echo "----------------------------------------------------"
echo "DEBUG INFO: Avvio applicazione GUI per le Release Notes..."
set +e # Disabilita l'uscita immediata in caso di errore per l'esecuzione dell'app
"$APP" "$COMMIT_MSG_FILE"
APP_EXIT_CODE=$?
set -e # Riabilita l'uscita immediata

echo "DEBUG INFO: Applicazione Fyne terminata con Exit Code: $APP_EXIT_CODE"

# Se l'app esce con un codice diverso da 0 (es. utente ha annullato il commit tramite la GUI)
if [ "$APP_EXIT_CODE" -ne 0 ]; then
    echo "DEBUG INFO: L'applicazione ha segnalato l'annullamento del commit (Exit Code: $APP_EXIT_CODE)."
    echo "Commit annullato dall'utente."
    exit 1
fi

# Controlla se il file release_notes.json esiste dopo l'esecuzione dell'app
if [ ! -f "$FILE_RELEASE_NOTES" ]; then
    echo "❌ ERRORE: Il file release_notes.json non è stato creato o non esiste dopo l'esecuzione dell'app."
    echo "Assicurati che l'applicazione abbia i permessi per creare il file."
    echo "Commit annullato."
    exit 1
fi

# Salva il timestamp di ultima modifica del file release_notes.json DOPO l'esecuzione dell'app
if [[ "$(uname)" == "Darwin" ]]; then # macOS
    AFTER_RN_FILE=$(stat -f %m "$FILE_RELEASE_NOTES" 2>/dev/null || echo 0)
else # Linux/Windows (con Git Bash)
    AFTER_RN_FILE=$(stat -c %Y "$FILE_RELEASE_NOTES" 2>/dev/null || echo 0)
fi
echo "DEBUG INFO: Timestamp finale di $FILE_RELEASE_NOTES: '$AFTER_RN_FILE'"

# --- VERIFICA SE UNA NOTA È STATA SALVATA (CONTROLLANDO IL TIMESTAMP) ---
if [ "$AFTER_RN_FILE" -le "$BEFORE_RN_FILE" ]; then
    echo "----------------------------------------------------"
    echo "❌ ERRORE: Nessuna nota di rilascio è stata salvata nel file $FILE_RELEASE_NOTES durante questa sessione."
    echo "Il file non è stato modificato dopo l'apertura dell'applicazione."
    echo "Assicurati di inserire almeno una nota di rilascio per questo commit."
    echo "Commit annullato."
    exit 1
fi

# Se tutto è OK, aggiungi il file release_notes.json allo staging
# Questo passaggio è per gestire i fine riga se non sono stati completamente risolti altrove.
git add "$FILE_RELEASE_NOTES"
if git diff --quiet --exit-code --cached "$FILE_RELEASE_NOTES"; then
    echo "DEBUG INFO: Il file $FILE_RELEASE_NOTES è nell'indice ed è pulito."
else
    # Questo fallback è utile se ci sono ancora problemi di fine riga che git diff --quiet rileva.
    echo "DEBUG INFO: Il file $FILE_RELEASE_NOTES è nell'indice ma ha modifiche non stagionate dopo 'git add'."
    echo "DEBUG INFO: Eseguo 'git add -f' come fallback per forzare l'aggiornamento dell'indice."
    git add -f "$FILE_RELEASE_NOTES" # Forza l'aggiunta per superare il problema dei fine riga
fi

echo "DEBUG INFO: Controllo finale stato Git dopo add:"
git status --porcelain

echo "----------------------------------------------------"
echo "✅ Successo: Almeno una nota di rilascio è stata salvata e il file $FILE_RELEASE_NOTES è aggiornato nell'indice."
echo "--- Fine esecuzione prepare-commit-msg hook ---"
echo "----------------------------------------------------"

exit 0
