#!/bin/bash
# post-commit hook
# Updates release_notes.json replacing PENDING hashes with the real commit hash.
# Only updates entries whose commitDate matches the current commit session.

REPO_ROOT=$(git rev-parse --show-toplevel)
RELEASE_NOTES_JSON="$REPO_ROOT/release_notes.json"

# Only proceed if release_notes.json exists and contains PENDING
if [ ! -f "$RELEASE_NOTES_JSON" ]; then
    exit 0
fi

if ! grep -q '"PENDING"' "$RELEASE_NOTES_JSON" 2>/dev/null; then
    exit 0
fi

# Get the actual commit hash
COMMIT_HASH=$(git rev-parse HEAD)

# Find the release-notes binary
RELEASE_TOOL=""
if command -v release-notes &> /dev/null; then
    RELEASE_TOOL="release-notes"
elif [ -f "$REPO_ROOT/release-notes" ]; then
    RELEASE_TOOL="$REPO_ROOT/release-notes"
fi

if [ -z "$RELEASE_TOOL" ]; then
    # Fallback: can't update hash without the tool, leave PENDING
    exit 0
fi

# Let the binary handle the update (only touches entries with matching session ID)
"$RELEASE_TOOL" --update-hash "$COMMIT_HASH" --output "$RELEASE_NOTES_JSON"

# Amend the commit to include the updated file
git add "$RELEASE_NOTES_JSON"
git commit --amend --no-edit --no-verify > /dev/null 2>&1

exit 0
