#!/bin/bash
REPO_ROOT=$(git rev-parse --show-toplevel)
TMP_JSON="$REPO_ROOT/.release_notes_tmp.json"
RELEASE_NOTES="$REPO_ROOT/release_notes.json"

if [ ! -f "$TMP_JSON" ]; then
  echo "ERRORE: file temporaneo $TMP_JSON mancante. Non puoi committare senza le release notes."
  exit 1
fi

# Lancia la tua app (che gestisce input/output JSON)
your_go_app --input "$TMP_JSON" --output "$RELEASE_NOTES"

if [ ! -s "$RELEASE_NOTES" ]; then
  echo "ERRORE: release notes JSON non creato o vuoto."
  exit 1
fi

git add "$RELEASE_NOTES"
rm "$TMP_JSON"

exit 0

